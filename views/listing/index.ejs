<% layout("/layouts/boilerplate") %>

<h3 class="mt-3 mb-3 text-center">Wonder Land</h3>

<div class="text-center mb-4">
    <a href="/listings/new" class="btn btn-dark">
        Create New Listing
    </a>
</div>

<div class="container">
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">

        <% for(let listing of allListing){ %>
            

            <div class="col">
               
                <div class="card h-100 shadow-sm">
                    <a class="listing-link" href="/listings/<%= listing._id %>">
                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="Listing Image">

                    <div class="card-body">

                        <h5 class="card-title">
                            <%= listing.title %>
                        </h5>

                        <p class="card-text">
                            <strong><%= listing.location %></strong>,
                            <%= listing.country %>

                            <br><br>

                            <strong>
                                <%= listing.price.toLocaleString("en-IN", {
                                    style: "currency",
                                    currency: "INR"
                                }) %>
                            </strong>
                            / night
                        </p>

                        <a href="/listings/<%= listing._id %>" class="btn btn-primary">
                            Book Now
                        </a>

                    </div>
                </a>
                </div>
            
            </div>
            
        
        <% } %>

    </div>
</div>