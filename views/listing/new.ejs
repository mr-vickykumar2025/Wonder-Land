<% layout("/layouts/boilerplate") %>

    <div class="row">
        <div class="col-8 offset-2">


            <h1>Create a new Listing</h1>
            <form action="/listings" method="POST" novalidate class="needs-validation">

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input required type="text" name="listing[title]" placeholder="Enter Title" class="form-control">
                    <div class="valid-feedback">
                        Title Looks good!
                    </div>
                </div>


                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea required name="listing[description]" type="text" placeholder="Enter description"
                        class="form-control"></textarea>
                    <div class="invalid-feedback">
                        Please add a short description
                    </div>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Image url:</label>
                    <input type="text" name="listing[image][url]" placeholder="Enter Image URL" class="form-control">
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price in INR</label>
                        <input required class="form-control" type="number" name="listing[price]"
                            placeholder="Enter price">
                        <div class="invalid-feedback">
                            Please add price
                        </div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input required type="text" class="form-control" name="listing[country]"
                            placeholder="Enter country name">
                        <div class="invalid-feedback">
                            Please add Country
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input required class="form-control" type="text" name="listing[location]"
                        placeholder="Enter location">
                    <div class="invalid-feedback">
                        Please add proper address
                    </div>
                </div>
                <br>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="terms" name="terms" required>
                    <label class="form-check-label" for="terms">
                        I agree to the <a href="/term/condtion" target="_blank">Terms and Conditions</a>
                    </label>
                    <div class="invalid-feedback">
                        Please agree to continue
                    </div>
                </div>
                <br>
                <div class="mb-3">
                    <button class="btn btn-dark add-btn
                    ">Add</button>
                </div>

            </form>
        </div>
    </div>