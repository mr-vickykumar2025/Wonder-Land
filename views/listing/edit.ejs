<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-8 offset-2">

            <h2>Update the Listing</h2>
            <form novalidate class="needs-validation" action="/listings/<%= foundlisting._id%>?_method=PUT" method="POST">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input required type="text" name="listing[title]" value="<%=foundlisting.title %>"
                        placeholder="Enter Title" class="form-control">
                    <div class="invalid-feedback">
                        Invalid Title
                    </div>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea required name="listing[description]" type="text" placeholder="Enter description"
                        class="form-control"><%= foundlisting.description %></textarea>
                    <div class="invalid-feedback">
                        Please add a short description
                    </div>
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Image URL:</label>
                    <input required type="text" name="listing[image][url]" value="<%= foundlisting.image.url %>"
                        class="form-control">
                    <div class="invalid-feedback">
                        Please add an Image URL.
                    </div>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price in INR</label>
                        <input required class="form-control" type="number" value="<%=foundlisting.price %>"
                            name="listing[price]">
                        <div class="invalid-feedback">
                            invalid price
                        </div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input required type="text" class="form-control" value="<%=foundlisting.country %>"
                            name="listing[country]">

                        <div class="invalid-feedback">
                            Please add a Country name
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input required class="form-control" type="text" value="<%=foundlisting.location %>"
                        name="listing[location]">
                    <div class="invalid-feedback">
                        Please add a proper address
                    </div>
                </div>
                <br>
                <div class="mb-3">
                    <button class="btn btn-dark edit-btn">Update</button>
                </div>
            </form>
        </div>
    </div>